# example.com public ingress (2026-10-11): TLS here, then over the Nebula overlay to Traefik on runtipi (10.42.0.11).
{
	email admin@example.net
	admin localhost:2019
}

# JSON access log for CrowdSec (security/crowdsec-lighthouse.sh)
(accesslog) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		# 2026-10-19: query values that carry secrets (OIDC code/state, Subsonic p/t/s, share tokens) are redacted;
		# CrowdSec keeps what it parses (remote_ip, status, method, host, user agent, uri path)
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace p REDACTED
					replace t REDACTED
					replace s REDACTED
					replace token REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

photos.example.com,
docs.example.com,
office.example.com,
auth.example.com,
paperless.example.com,
mealie.example.com,
