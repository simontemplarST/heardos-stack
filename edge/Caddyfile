dash.example.com {
	import accesslog
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip
	request_body {
		max_size 0
	}
	# 2026-10-19 HeardOS desktop (framing): apps open as windows inside https://dash.example.com. Only the desktop may
	# frame them (plus Nextcloud for OnlyOffice); header_down takes no matcher, hence one handle per policy.
	# Sign-in, vault and the top-level pages (dash, hub) are never framed: they keep the app's own XFO/frame-ancestors.
	@noframe host auth.example.com vault.example.com dash.example.com hub.example.com
	handle @noframe {
		reverse_proxy 10.42.0.11:80 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			# 2026-10-11 reliability tuning: retry briefly on a tunnel hiccup instead of answering 502; keep upstream connections warm
			lb_try_duration 15s
			lb_try_interval 500ms
			transport http {
				dial_timeout 10s
				response_header_timeout 120s
				keepalive 2m
				keepalive_idle_conns 32
			}
		}
	}
	@frame_office host office.example.com
	handle @frame_office {
		reverse_proxy 10.42.0.11:80 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors 'self'" "frame-ancestors 'self' https://dash.example.com https://docs.example.com"
			header_down Content-Security-Policy "frame-ancestors 'none'" "frame-ancestors https://dash.example.com https://docs.example.com"
			header_down +Content-Security-Policy "frame-ancestors 'self' https://dash.example.com https://docs.example.com"
			# 2026-10-11 reliability tuning: retry briefly on a tunnel hiccup instead of answering 502; keep upstream connections warm
			lb_try_duration 15s
			lb_try_interval 500ms
			transport http {
				dial_timeout 10s
				response_header_timeout 120s
				keepalive 2m
				keepalive_idle_conns 32
			}
		}
	}
	handle {
		reverse_proxy 10.42.0.11:80 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors 'self'" "frame-ancestors 'self' https://dash.example.com"
			header_down Content-Security-Policy "frame-ancestors 'none'" "frame-ancestors https://dash.example.com"
			header_down +Content-Security-Policy "frame-ancestors 'self' https://dash.example.com"
			# 2026-10-11 reliability tuning: retry briefly on a tunnel hiccup instead of answering 502; keep upstream connections warm
			lb_try_duration 15s
			lb_try_interval 500ms
			transport http {
				dial_timeout 10s
				response_header_timeout 120s
				keepalive 2m
				keepalive_idle_conns 32
			}
		}
	}
}

# cloud.example.com (2026-10-14): one front door for every app behind Authentik.
# https://cloud.example.com/<authentik-app-slug>[/path] -> 302 to the app's real host (aliases = the public subdomain names).
# "/" and unknown slugs -> the Authentik "My applications" library. Pure redirects: no overlay hop, no auth needed here.
cloud.example.com {
	import accesslog
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	map {uri} {dest} {
		~^/(?:actual-budget|budget)(/[^?]*)?(\?.*)?$ "https://budget.example.com${1}${2}"
		~^/(?:baikal|dav)/?(\?.*)?$ "https://dav.example.com/admin/${1}"
		~^/(?:baikal|dav)(/[^?]*)?(\?.*)?$ "https://dav.example.com${1}${2}"
		~^/(?:cronmaster|cron)(/[^?]*)?(\?.*)?$ "https://cron.example.com${1}${2}"
		~^/dash(/[^?]*)?(\?.*)?$ "https://dash.example.com${1}${2}"
		~^/(?:hortusfox|plants)(/[^?]*)?(\?.*)?$ "https://plants.example.com${1}${2}"
		~^/(?:archivebox|archive)(/[^?]*)?(\?.*)?$ "https://archive.example.com${1}${2}"
		~^/(?:listmonk|news)(/[^?]*)?(\?.*)?$ "https://news.example.com${1}${2}"
		~^/(?:kiwix|wiki|wikipedia)(/[^?]*)?(\?.*)?$ "https://wiki.example.com${1}${2}"
		~^/(?:searxng|search)(/[^?]*)?(\?.*)?$ "https://search.example.com${1}${2}"
		~^/(?:home-assistant|home)(/[^?]*)?(\?.*)?$ "https://home.example.com${1}${2}"
		~^/homebox(/[^?]*)?(\?.*)?$ "https://homebox.example.com${1}${2}"
		~^/hub(/[^?]*)?(\?.*)?$ "https://hub.example.com${1}${2}"
		~^/(?:immich|photos)(/[^?]*)?(\?.*)?$ "https://photos.example.com${1}${2}"
		~^/(?:invidious|tube)(/[^?]*)?(\?.*)?$ "https://tube.example.com${1}${2}"
		~^/(?:calibre-web|books)(/[^?]*)?(\?.*)?$ "https://books.example.com${1}${2}"
		~^/mealie(/[^?]*)?(\?.*)?$ "https://mealie.example.com${1}${2}"
		~^/(?:navidrome|music)(/[^?]*)?(\?.*)?$ "https://music.example.com${1}${2}"
		~^/(?:nextcloud|docs)(/[^?]*)?(\?.*)?$ "https://docs.example.com${1}${2}"
		~^/paperless(/[^?]*)?(\?.*)?$ "https://paperless.example.com${1}${2}"
		~^/(?:vaultwarden|vault)(/[^?]*)?(\?.*)?$ "https://vault.example.com${1}${2}"
		~^/wallos(/[^?]*)?(\?.*)?$ "https://wallos.example.com${1}${2}"
		~^/auth(/[^?]*)?(\?.*)?$ "https://auth.example.com${1}${2}"
		# 2026-10-19: no LAN-only targets here (Proxmox, Runtipi): this host answers anyone without signing in, so a
		# redirect would disclose internal names/addresses. Launch those from the LAN / overlay directly.
		default "https://auth.example.com/if/user/"
	}
	# brand assets for emails etc. (2026-10-15): https://cloud.example.com/brand/<file>, served before the redirect map
	handle_path /brand/* {
		root * /srv/heardos-brand
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		redir {dest} 302
	}
}
