# HeardOS generic build — the plan file.
# Copy to heardos.env, fill in, keep it at 0600. Every script sources it.
# Lines marked (generated) are filled in by the scripts; leave them empty at first.

# --- identity of the installation ---------------------------------------------
DOMAIN=example.com                       # public zone; apps live at <name>.$DOMAIN
ACME_EMAIL=you@example.com               # Let's Encrypt contact
TZ=America/Chicago
ADMIN_USER=alice                       # first Authentik admin (not akadmin)
ADMIN_EMAIL=you@example.com
PUBLIC_HOSTS="auth paperless mealie home homebox dav music docs office photos"

# --- the compute host (any x86-64 Ubuntu 24.04 machine) -----------------------
HOST_LAN_IP=192.168.10.50                    # give it a DHCP reservation or a static IP
LAN_SUBNET=192.168.10.0/24
LAN_DOMAIN=192-168-10-50.sslip.io            # LAN names: <name>.$LAN_DOMAIN (sslip resolves to HOST_LAN_IP without any DNS server)
HEARDOS_ROOT=/opt/heardos                # stacks/, data/, secrets/, dynamic/ live here
HOST_OVERLAY=10.42.0.11                  # this host's Nebula address
# Docker "proxy" network shared by Traefik and every app. 10-host-bootstrap.sh creates it with this subnet and hands out
# dynamic addresses only from the upper half (PROXY_IP_RANGE), so TRAEFIK_PROXY_IP is never taken by another container.
# Apps that trust identity/X-Forwarded headers trust ONLY TRAEFIK_PROXY_IP (/32), never the whole subnet.
PROXY_SUBNET=172.30.0.0/24
PROXY_IP_RANGE=172.30.0.128/25
TRAEFIK_PROXY_IP=172.30.0.2
MEDIA_GID=1500                           # shared group (heardos-media) for media/documents, media/music, paperless/consume
LAN_HTTP=0                               # 1 = also register http://<app>.$LAN_DOMAIN OIDC redirects + Paperless CSRF origin
                                         # (plain HTTP on the LAN: passwords/cookies in clear). Off by default; the kit has
                                         # no LAN TLS yet, so with 0 sign in through the public https names.

# --- the VPS (any provider; root ssh with your key, Ubuntu 24.04, public IPv4) --
NEBULA_LH_IP=                            # public IPv4 of the VPS
NEBULA_LH_OVERLAY=10.42.0.1
OVERLAY_CIDR=10.42.0.0/24
LAPTOP_OVERLAY=10.42.0.20

# --- DNS (Cloudflare API, zone-scoped token with DNS:Edit) ----------------------
CF_API_TOKEN=
CF_ZONE_ID=

# --- management -----------------------------------------------------------------
PORTAINER_URL=https://192.168.10.50:9443
PORTAINER_TOKEN=                         # (optional) Portainer access token; without it stacks deploy with docker compose
AUTHENTIK_URL=http://192.168.10.50:9000      # LAN URL used by the automation scripts
AUTHENTIK_TOKEN=                         # written by 40-authentik-stack.sh: the heardos-automation service account, 90-day token;
                                         # rotate with 42-ak-app.py token rotate --write-env (the bootstrap token is revoked)
# Immich CPU caps (fractions of host cores). Keep the sum under the host core count so transcodes never starve SSO/ingress.
IMMICH_SERVER_CPUS=2.0
IMMICH_ML_CPUS=1.0
# Paperless OCR languages ("eng+deu"); OCR_CPUS only matters for the optional heardos-ocr stack (off by default)
OCR_LANGS=eng
OCR_CPUS=2.0
# KIWIX_ZIM=wikipedia_en_all_maxi_2026-08.zim   # 50-app.sh kiwix: ~119 GB; wikipedia_en_all_nopic_* is ~50 GB, *_mini_* ~12 GB (download.kiwix.org/zim/wikipedia)
# Memory caps (docker mem_limit); raise if the host has room and the app gets OOM-killed
# ONLYOFFICE_MEM=3g  NEXTCLOUD_MEM=3g  IMMICH_ML_MEM=4g  OLLAMA_MEM=6g  ARCHIVEBOX_MEM=3g
# 70-backup.sh: RESTIC_REPOSITORY=/mnt/backup/heardos (or sftp:user@host:/path, s3:...); BACKUP_INCLUDE_MEDIA=true
