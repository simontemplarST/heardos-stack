# Traefik file-provider config: Authentik forward auth + helpers. Rendered by 31-edge-stack.sh into ${HEARDOS_ROOT}/dynamic/.
http:
  middlewares:
    authentik-fwd:
      forwardAuth:
        address: http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
        # passes the client's X-Forwarded-* on to Authentik (it needs the real host/proto/client IP). Only safe because
        # the web entrypoint's forwardedHeaders.trustedIPs is the lighthouse /32: Traefik drops X-Forwarded-* from
        # anyone else before this middleware sees them. Widen trustedIPs and this becomes a spoofing hole.
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-jwt
          - X-authentik-meta-jwks
          - X-authentik-meta-outpost
          - X-authentik-meta-provider
          - X-authentik-meta-app
          - X-authentik-meta-version
    # Removes every identity header a client could forge (empty value = delete). Applied to the whole web entrypoint
    # (traefik compose: --entrypoints.web.http.middlewares=strip-authentik@file), so it runs before any router's
    # middlewares: authentik-fwd then sets the real values from Authentik's answer. Keep this list identical to
    # authResponseHeaders above. LAN routes of header-login apps also name it explicitly (harmless twice).
    strip-authentik:
      headers:
        customRequestHeaders:
          X-authentik-username: ""
          X-authentik-groups: ""
          X-authentik-email: ""
          X-authentik-name: ""
          X-authentik-uid: ""
          X-authentik-jwt: ""
          X-authentik-meta-jwks: ""
          X-authentik-meta-outpost: ""
          X-authentik-meta-provider: ""
          X-authentik-meta-app: ""
          X-authentik-meta-version: ""
    xfp-https:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: https
          X-Forwarded-Port: "443"
  services:
    authentik-outpost:
      loadBalancer:
        servers:
          - url: http://authentik-server:9000
