# Nebula node "${NODE_NAME}" on the ${OVERLAY_CIDR} overlay. Lighthouse/relay = ${NEBULA_LH_OVERLAY} @ ${NEBULA_LH_IP}:4242.
pki:
  ca: /etc/nebula/ca.crt
  cert: /etc/nebula/host.crt
  key: /etc/nebula/host.key
static_host_map:
  "${NEBULA_LH_OVERLAY}": ["${NEBULA_LH_IP}:4242"]
lighthouse:
  am_lighthouse: false
  interval: 60
  hosts: ["${NEBULA_LH_OVERLAY}"]
listen:
  host: "[::]"
  port: 0
  read_buffer: 10485760
  write_buffer: 10485760
  batch: 64
punchy:
  punch: true
  respond: true
relay:
  relays: ["${NEBULA_LH_OVERLAY}"]
  am_relay: false
  use_relays: true
tun:
  disabled: false
  dev: nebula1
  mtu: 1300
  tx_queue: 1000
logging:
  level: info
  format: text
firewall:
  outbound_action: drop
  inbound_action: drop
  conntrack: {tcp_timeout: 12m, udp_timeout: 3m, default_timeout: 10m}
  outbound:
    - {port: any, proto: any, host: any}
  inbound:
    - {port: any, proto: icmp, host: any}
    - {port: any, proto: any, groups: [admins]}
    - {port: any, proto: any, groups: [servers]}
${INGRESS_RULE}
routines: ${NEBULA_ROUTINES}
