# actual-to-wallos.env — read by `docker run --env-file` (plain KEY=VALUE, no quotes, no export). Keep 0600.
ACTUAL_URL=http://actual-budget_migrated-actual-budget-1:5006
ACTUAL_SYNC_ID=00000000-0000-4000-8000-000000000000
ACTUAL_DATA_DIR=/data/actual-cache
# The sync server is OpenID-only, so a password cannot log in. Paste the value of localStorage["user-token"] from
# https://budget.example.com (DevTools -> Application -> Local Storage). OpenID sessions there never expire (expires_at -1).
ACTUAL_SESSION_TOKEN=
# Alternative (only after ~/heardos-install/dash/enable-actual-api-password.sh has been run on CT 108):
ACTUAL_API_PASSWORD=
WALLOS_URL=http://wallos_migrated-wallos-1:80
# Wallos -> Settings -> "API key" (user alice already has one)
WALLOS_API_KEY=
WALLOS_CURRENCY=USD
# which Actual schedule frequencies become Wallos subscriptions: monthly | monthly,yearly,weekly,daily
SYNC_CYCLES=monthly,quarterly
SUBSCRIPTION_GROUPS=Subscriptions,Bills & Utilities
MIN_CHARGES=2
STALE_CYCLES=2
LOOKBACK_DAYS=400
LOGO_SEARCH=1
